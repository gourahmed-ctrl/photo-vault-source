name: Build Android APK (Auto-Detect)

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - name: Checkout Code
      uses: actions/checkout@v4

    - name: Set up JDK
      uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'temurin'

    - name: Find and Run Gradlew
      run: |
        # البحث عن مجلد gradlew تلقائياً
        GRADLE_DIR=$(dirname $(find . -name "gradlew" | head -n 1))
        echo "Found gradlew in: $GRADLE_DIR"
        
        # الدخول للمجلد وتشغيل البناء
        cd "$GRADLE_DIR"
        chmod +x ./gradlew
        ./gradlew assembleDebug

    - name: Upload any APK found
      uses: actions/upload-artifact@v4
      with:
        name: final-app-apk
        path: "**/*.apk"
